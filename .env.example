# ==============================================================================
# Sistema JCB Pecuária - Variáveis de Ambiente Locais
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto ou configure em seu ambiente.
# O Spring Boot carrega automaticamente optional:file:.env[.properties]

# Configurações do Banco de Dados PostgreSQL
JCB_DB_URL=jdbc:postgresql://localhost:5432/sistemajcb
JCB_DB_USERNAME=postgres
JCB_DB_PASSWORD=postgres

# Configurações de Segurança e JWT
# Utilize uma chave com entropia suficiente (mínimo 256 bits / 32 caracteres)
JCB_JWT_SECRET=super_secret_jwt_key_sistemajcb_dev_environment_min_32_chars