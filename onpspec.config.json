{
  "testCommand": "./scripts/check-all.sh",
  "reporter": "exitcode",
  "testGlobs": [
    "frontend/tests/**",
    "usecase/src/test/**",
    "application/src/test/**",
    "core/src/test/**",
    "infra/src/test/**",
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**"
  ],
  "srcGlobs": [
    "core/src/**",
    "usecase/src/**",
    "application/src/**",
    "infra/src/**",
    "frontend/src/**"
  ]
}
